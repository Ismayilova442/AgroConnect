<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AgroConnect.Web</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AgroConnect.Web.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

    <style>
        /* ================= NAVBAR REDESIGN ================= */
        .custom-navbar {
            background: #ffffff;
            padding: 0.55rem 1.25rem;
            box-shadow: 0 2px 12px rgba(0, 0, 0, 0.07);
            position: sticky;
            top: 0;
            z-index: 1030;
        }

        .custom-brand {
            font-size: 1.35rem;
            font-weight: 700;
            white-space: nowrap;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        #navbarAgro .navbar-nav {
            align-items: center;
            gap: 2px;
        }

        #navbarAgro .nav-item .nav-link {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            white-space: nowrap;
            padding: 0.5rem 0.85rem;
            border-radius: 8px;
            font-weight: 500;
            font-size: 0.93rem;
            color: #3a3a3a;
            transition: background-color 0.15s ease, color 0.15s ease;
        }

            #navbarAgro .nav-item .nav-link:hover {
                background-color: #eef5ef;
                color: #2e7d32;
            }

            #navbarAgro .nav-item .nav-link i {
                font-size: 1rem;
                line-height: 1;
            }

        /* Xüsusi ("badge" tərzli) linklər - vahid dizayn */
        .link-admin,
        .link-fermer-ol,
        .link-chat,
        .link-ai {
            border-radius: 20px !important;
            padding: 0.45rem 0.95rem !important;
        }

        .link-admin {
            background-color: #212529;
            color: #ffffff !important;
        }

            .link-admin:hover {
                background-color: #000000;
                color: #ffffff !important;
            }

        .link-fermer-ol {
            background-color: #fff3cd;
            color: #856404 !important;
        }

            .link-fermer-ol:hover {
                background-color: #ffe8a1;
                color: #6b5300 !important;
            }

        .link-chat {
            background-color: #e8f5e9;
            color: #2e7d32 !important;
        }

            .link-chat:hover {
                background-color: #d4ecd6;
            }

        .link-ai {
            background-color: #e3f2fd;
            color: #1565c0 !important;
        }

            .link-ai:hover {
                background-color: #cfe8fc;
            }

        /* Səbət ikonu */
        .cart-wrapper {
            width: 42px;
            height: 42px;
            border-radius: 50%;
            background-color: #eef5ef;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: background-color 0.15s ease;
        }

            .cart-wrapper:hover {
                background-color: #dcede0;
            }

        /* Login/Logout hissəsi */
        #navbarAgro .d-flex.align-items-center {
            gap: 0.75rem;
        }

        /* Toggler (hamburger) düyməsinin görünüşü */
        .custom-toggler {
            border: none;
            padding: 0.4rem;
        }

            .custom-toggler:focus {
                box-shadow: none;
            }

        /* ================= RESPONSIVE (mobil/tablet) =================
           navbar-expand-lg 992px-də collapse olur, ona görə bu qaydalar
           da MƏHZ 991.98px-ə qədər tətbiq olunmalıdır (1024px yox).
           Əvvəlki eyni bloğun DUBLİKATI silindi. */
        /* @@media (max-width: 991.98px) {
            .custom-navbar

        {
                padding: 0.5rem 1rem !important;
            }

        #navbarAgro {
                margin-top: 0.75rem !important;
                border-top: 1px solid #eee !important;
                padding-top: 0.5rem !important;
        }

            #navbarAgro .navbar-nav {
                    width: 100% !important;
                    gap: 0 !important;
            }

            #navbarAgro .nav-item {
                    width: 100% !important;
                    border-bottom: 1px solid #f2f2f2 !important;
            }

                #navbarAgro .nav-item .nav-link {
                        width: 100% !important;
                        border-radius: 0 !important;
                        padding: 0.7rem 0.5rem !important;
                }

        .link-admin, .link-fermer-ol, .link-chat, .link-ai {
            border-radius: 8px !important;
                margin: 2px 0 !important;
        }

        #navbarAgro .d-flex.align-items-center {
                width: 100% !important;
                justify-content: flex-start !important;
                padding-top: 0.5rem !important;
        }

        }

        @@media (max-width: 400px) {
            .custom-brand

        {
                font-size: 1.1rem !important;
        }

        } */
    </style>
</head>
<body>


    <header>
        <nav class="navbar navbar-expand-lg navbar-light custom-navbar">
            <div class="container-fluid">
                <!-- Brend / Loqo -->
                <a class="navbar-brand custom-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="fas fa-leaf" style="color: #ffb300;"></i> Agro<span>Connect</span>
                </a>

                <!-- Mobil Versiyada Sağda Dayanan Hissə (Səbət və Hamburger) -->
                <div class="d-flex d-flex-mobile order-lg-3 align-items-center">
                    <ul class="navbar-nav me-2 me-lg-0">
                        <li class="nav-item">
                            <a class="nav-link text-success cart-wrapper" asp-area="" asp-controller="Marketplace" asp-action="Cart">
                                <i class="bi bi-cart3 fs-5"></i>
                            </a>
                        </li>
                    </ul>

                    <!-- Hamburger Düyməsi -->
                    <button class="navbar-toggler custom-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarAgro" aria-controls="navbarAgro" aria-expanded="false" aria-label="Toggle navigation">
                        <span class="hamburger-box">
                            <span class="hamburger-inner"></span>
                        </span>
                    </button>
                </div>

                <!-- Menyu Linkləri -->
                <div class="collapse navbar-collapse justify-content-between order-lg-2" id="navbarAgro">
                    <ul class="navbar-nav flex-grow-1 ms-lg-3">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door"></i> Ana Səhifə
                            </a>
                        </li>

                        @if (User.IsInRole("SuperAdmin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link link-admin fw-bold" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                                    <i class="bi bi-speedometer2"></i> Admin Panel
                                </a>
                            </li>
                        }
                        @if (User.IsInRole("Member"))
                        {
                            <li class="nav-item">
                                <a class="nav-link link-fermer-ol fw-bold" asp-area="" asp-controller="Farmer" asp-action="Apply">
                                    <i class="bi bi-patch-check"></i> Fermer Ol
                                </a>
                            </li>
                        }
                        @if (User.IsInRole("Farmer"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-primary fw-bold" asp-area="" asp-controller="Product" asp-action="Index">
                                    <i class="bi bi-flower1"></i> Təsərrüfatım
                                </a>
                            </li>
                        }

                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Marketplace" asp-action="Index">
                                <i class="bi bi-shop"></i> Marketplace
                            </a>
                        </li>
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Marketplace" asp-action="MyOrders">
                                    <i class="bi bi-bag-check"></i> Sifarişlərim
                                </a>
                            </li>
                        }
                        @if (User.IsInRole("Farmer"))
                        {
                            @* <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Forum" asp-action="Index">
                                    <i class="bi bi-chat-square-text"></i> Forum
                                </a>
                            </li> *@
                            @* <li class="nav-item">
                                <a class="nav-link link-chat fw-bold" asp-area="" asp-controller="Chat" asp-action="Index">
                                    <i class="bi bi-broadcast"></i> Canlı Çat
                                </a>
                            </li> *@
                        }
                        @* <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Map" asp-action="Index">
                                <i class="bi bi-geo-alt"></i> Xəritə
                            </a>
                        </li> *@
                        @* <li class="nav-item">
                            <a class="nav-link link-ai fw-bold" asp-area="" asp-controller="AICoach" asp-action="Index">
                                <i class="bi bi-robot"></i> AI Aqronom
                            </a>
                        </li> *@
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Complaint" asp-action="Index">
                                <i class="bi bi-megaphone"></i> Şikayətlər
                            </a>
                        </li>
                    </ul>

                    <!-- Giriş / Qeydiyyat qismi -->
                    <div class="d-flex align-items-center mt-3 mt-lg-0">
                        <partial name="_LoginPartial" />
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="custom-footer border-top">
        <div class="container">
            <div class="footer-content">
                <!-- Brend Hissəsi -->
                <div class="footer-brand">
                    <i class="fas fa-leaf logo-icon"></i>
                    <span class="brand-text">Agro<span>Connect</span> Hub</span>
                </div>

                <!-- Mərkəzi Linklər (Sevimlilərim) -->
                <div class="footer-links">
                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <a asp-controller="Wishlist" asp-action="Index" class="footer-link-item wishlist-link">
                            <i class="bi bi-heart-fill"></i> Sevimlilərim
                        </a>
                    }
                </div>

                <!-- Sosial Şəbəkələr -->
                <div class="footer-social">
                    <!-- WhatsApp -->
                    <a href="https://wa.me/994xxxxxxxxx" class="social-btn whatsapp" target="_blank" title="WhatsApp">
                        <i class="bi bi-whatsapp"></i>
                    </a>
                    <!-- Instagram -->
                    <a href="https://instagram.com/sizin_hesab" class="social-btn instagram" target="_blank" title="Instagram">
                        <i class="bi bi-instagram"></i>
                    </a>
                    <!-- TikTok -->
                    <a href="https://tiktok.com/sizin_hesab" class="social-btn tiktok" target="_blank" title="TikTok">
                        <i class="bi bi-tiktok"></i>
                    </a>
                </div>
            </div>

            <!-- Ən alt hissə (Copyright) -->
            <div class="footer-bottom">
                <p>&copy; @DateTime.Now.Year AgroConnect. Bütün hüquqlar qorunur.</p>
            </div>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
