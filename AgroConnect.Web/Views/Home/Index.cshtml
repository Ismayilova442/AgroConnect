@{
    ViewData["Title"] = "Ana Səhifə";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">

<div class="container text-center">
    <div class="hero-section animate__animated animate__fadeIn">
        <h1>AgroConnect-ə Xoş Gəlmisiniz!</h1>
        <p>Müasir kənd təsərrüfatı ekosisteminə qoşulun. Məhsulunuzu satın, süni intellekt rəyi alın və digər fermerlərlə canlı ünsiyyət qurun.</p>
        <a href="/Account/Register" class="btn-agro" id="btnStart">İndi Başla <i class="fas fa-arrow-right ms-2"></i></a>
    </div>

    <h2 class="section-title">Platformanın İmkanları</h2>

    <div class="row">
        <div class="col-lg-4 col-md-6 col-sm-12">
            <div class="agro-card">
                <div class="icon-wrapper">
                    <i class="fas fa-robot"></i>
                </div>
                <h3>AI Aqronom</h3>
                <p>Məhsullarınızdakı xəstəlikləri və torpaq keyfiyyətini süni intellekt dəstəyi ilə anında analiz edin.</p>
                <a href="/AICoach" class="card-link">Məsləhət Al <i class="fas fa-chevron-right"></i></a>
            </div>
        </div>

        <div class="col-lg-4 col-md-6 col-sm-12">
            <div class="agro-card">
                <div class="icon-wrapper">
                    <i class="fas fa-store"></i>
                </div>
                <h3>Marketplace</h3>
                <p>Vasitəçilər olmadan birbaşa alıcılara çıxış əldə edin, məhsullarınızı ən doğru qiymətə satın.</p>
                <a href="/Marketplace" class="card-link">Bazara Bax <i class="fas fa-chevron-right"></i></a>
            </div>
        </div>

        <div class="col-lg-4 col-md-6 col-sm-12">
            <div class="agro-card">
                <div class="icon-wrapper">
                    <i class="fas fa-comments"></i>
                </div>
                <h3>Canlı Çat</h3>
                <p>Digər fermerlər və aqronom mütəxəssislərlə real vaxt rejimində təcrübələrinizi bölüşün.</p>
                <a href="/Chat" class="card-link">Söhbətə Qoşul <i class="fas fa-chevron-right"></i></a>
            </div>
        </div>
    </div>

    <div class="row mt-lg-3">
        <div class="col-lg-6 col-md-6 col-sm-12">
            <div class="agro-card">
                <div class="icon-wrapper">
                    <i class="fas fa-map-marked-alt"></i>
                </div>
                <h3>Kənd Təsərrüfatı Xəritəsi</h3>
                <p>Bölgələrə görə torpaq məhsuldarlığı və hava şəraitini interaktiv xəritə üzərindən izləyin.</p>
                <a href="/Map" class="card-link">Xəritəni Aç <i class="fas fa-chevron-right"></i></a>
            </div>
        </div>

        <div class="col-lg-6 col-md-6 col-sm-12">
            <div class="agro-card">
                <div class="icon-wrapper">
                    <i class="fas fa-users"></i>
                </div>
                <h3>Fermer Forumu</h3>
                <p>Suallarınızı paylaşın, yeni texnologiyalar haqqında müzakirələrə qoşulun və həllər tapın.</p>
                <a href="/Forum" class="card-link">Foruma Keç <i class="fas fa-chevron-right"></i></a>
            </div>
        </div>
    </div>
</div>

