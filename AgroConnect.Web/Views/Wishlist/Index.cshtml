@model IEnumerable<AgroConnect.Domain.Entities.Wishlist>
@{
    ViewData["Title"] = "Sevimlilərim";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">@TempData["Success"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}

<h2 class="mb-4"><i class="bi bi-heart-fill text-danger"></i> Sevimlilərim</h2>

@if (!Model.Any())
{
    <div class="alert alert-info">
        Sevimlilər siyahınız boşdur. <a asp-controller="Marketplace" asp-action="Index">Alış-verişə başlayın!</a>
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-3 g-4">
        @foreach (var item in Model)
        {
            var p = item.Product;
            if (p == null) { continue; }

            <div class="col">
                <div class="card h-100 shadow-sm border-0">
                    @if (!string.IsNullOrEmpty(p.ImageUrl))
                    {
                        <img src="@p.ImageUrl" class="card-img-top" alt="@p.Title" style="height: 200px; object-fit: cover;">
                    }
                    <div class="card-body">
                        <h5 class="card-title">@p.Title</h5>
                        <p class="text-muted small">@p.Category?.Name</p>
                        <h5 class="text-success fw-bold">@p.Price.ToString("0.00") AZN</h5>
                    </div>
                    <div class="card-footer bg-white d-flex justify-content-between">
                        <form asp-controller="Marketplace" asp-action="AddToCart" method="post">
                            <input type="hidden" name="productId" value="@p.Id" />
                            <input type="hidden" name="quantity" value="1" />
                            <button type="submit" class="btn btn-sm btn-success" disabled="@(p.StockQuantity <= 0)">
                                <i class="bi bi-cart-plus"></i> Səbətə at
                            </button>
                        </form>
                        <form asp-action="Remove" asp-route-id="@item.Id" method="post">
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
}
