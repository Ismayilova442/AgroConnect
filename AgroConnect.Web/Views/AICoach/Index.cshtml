@{
    ViewData["Title"] = "AI Aqronom";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">

<div class="container ai-page-container">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-md-10 col-12 text-center mb-4 animate__animated animate__fadeIn">
            <h1 class="text-success fw-bold ai-main-title"><i class="bi bi-robot"></i> Süni İntellekt (AI) Aqronom</h1>
            <p class="lead ai-lead-text">Bitkinizin şəklini yükləyin, süni intellekt onun xəstəliyini və həll yolunu tapsın.</p>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8 col-12">
            <div class="card shadow border-0 ai-upload-card">
                <div class="card-body p-4 p-sm-5 text-center">
                    <form asp-action="AnalyzeImage" method="post" enctype="multipart/form-data" id="aiForm">
                        <div class="mb-4">
                            <label for="plantImage" class="form-label fw-bold fs-5 text-dark">Şəkli seçin</label>
                            <input class="form-control form-control-lg custom-file-input" type="file" id="plantImage" name="plantImage" accept="image/*" required>
                        </div>

                        @if (ViewBag.Error != null)
                        {
                            <div class="alert alert-danger">@ViewBag.Error</div>
                        }

                        <button type="submit" class="btn btn-success btn-lg w-100 btn-analyze" id="analyzeBtn" onclick="showLoader()">
                            <i class="bi bi-search me-2"></i> Analiz Et
                        </button>

                        <div id="loader" class="mt-3 d-none">
                            <div class="spinner-border text-success" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                            <p class="text-muted mt-2 fw-medium">Şəkil analiz edilir, gözləyin...</p>
                        </div>
                    </form>
                </div>
            </div>

            @if (ViewBag.AnalysisResult != null)
            {
                <div class="card shadow border-success mt-4 ai-result-card animate__animated animate__fadeInUp">
                    <div class="card-header bg-success text-white fw-bold py-3">
                        <i class="bi bi-file-earmark-text me-2"></i> Analiz Nəticəsi
                    </div>
                    <div class="card-body p-4">
                        @Html.Raw(ViewBag.AnalysisResult)
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<script>
    function showLoader() {
        if(document.getElementById('plantImage').files.length > 0) {
            document.getElementById('analyzeBtn').classList.add('d-none');
            document.getElementById('loader').classList.remove('d-none');
        }
    }
</script>