@{
    ViewData["Title"] = "Tezliklə";
}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />

<div class="container">
    <div class="row justify-content-center">
        <div class="col-lg-7 col-md-9 col-12">
            <div class="text-center py-5 px-3 px-sm-5 my-4 my-md-5 bg-white rounded-4 shadow-sm border">

                <div class="mb-4">
                    <i class="bi bi-robot text-success" style="font-size: 4.5rem; opacity: 0.85;"></i>
                </div>

                <h1 class="fw-bold text-success mb-2" style="font-size: clamp(1.6rem, 4vw, 2.2rem);">
                    Süni İntellekt (AI) Aqronom
                </h1>

                <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill px-3 py-2 mb-4 fw-semibold">
                    <i class="bi bi-hourglass-split me-1"></i> Tezliklə istifadəyə veriləcək
                </span>

                <p class="text-muted fs-6 mb-1 px-md-4">
                    Bu funksiya hazırda inkişaf mərhələsindədir. Bitki şəklinizi yükləyərək
                    xəstəlik və zərərverici analizi tezliklə mümkün olacaq.
                </p>
                <p class="text-muted small mb-4">
                    Yaxın zamanda daha ağıllı və dəqiq nəticələrlə geri qayıdırıq. Səbrinizə görə təşəkkür edirik!
                </p>

                <div class="d-flex flex-column flex-sm-row justify-content-center gap-2 mt-4">
                    <a asp-controller="Marketplace" asp-action="Index" class="btn btn-success px-4">
                        <i class="bi bi-shop me-1"></i> Marketplace-ə keç
                    </a>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary px-4">
                        <i class="bi bi-house-door me-1"></i> Ana Səhifə
                    </a>
                </div>

            </div>
        </div>
    </div>
</div>
