@model IEnumerable<AgroConnect.Domain.Entities.Product>
@{
    ViewData["Title"] = "Mənim Məhsullarım";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>@ViewData["Title"]</h2>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-circle"></i> Yeni Məhsul</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">Hələ heç bir məhsul əlavə etməmisiniz.</div>
}
else
{
    <div class="row row-cols-1 row-cols-md-3 g-4">
        @foreach (var item in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm border-0">
                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                    {
                        <img src="@item.ImageUrl" class="card-img-top" alt="@item.Title" style="height: 200px; object-fit: cover;">
                    }
                    <div class="card-body">
                        <h5 class="card-title">@item.Title</h5>
                        <p class="card-text text-muted text-truncate">@item.Description</p>
                        <div class="d-flex justify-content-between align-items-center mt-3">
                            <span class="fs-5 fw-bold text-success">@item.Price AZN</span>
                            <span class="badge bg-secondary">Stok: @item.StockQuantity</span>
                        </div>
                    </div>
                    <div class="card-footer bg-white border-top-0 d-flex justify-content-between">
                        <small class="text-muted"><i class="bi bi-tag-fill"></i> @item.Category?.Name</small>
                    </div>
                </div>
            </div>
        }
    </div>
}
