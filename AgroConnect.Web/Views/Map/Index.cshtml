@model IEnumerable<AgroConnect.Domain.Entities.FarmerProfile>
@{
    ViewData["Title"] = "Fermerlər Xəritəsi";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-geo-alt-fill text-danger"></i> Fermerlər Xəritəsi</h2>
    <p class="text-muted mb-0">Azərbaycan üzrə fermerlərimizi kəşf edin</p>
</div>

<div class="card shadow border-0 mb-5">
    <div class="card-body p-0">
        <div id="map" style="height: 600px; width: 100%; border-radius: 5px;"></div>
    </div>
</div>

@section Scripts {
    <!-- Leaflet CSS -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
    <!-- Leaflet JS -->
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>

    <script>
        // Xəritəni mərkəzləşdiririk (Azərbaycan koordinatları)
        var map = L.map('map').setView([40.1431, 47.5769], 7);

        L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
            maxZoom: 19,
            attribution: '&copy; <a href="http://www.openstreetmap.org/copyright">OpenStreetMap</a>'
        }).addTo(map);

        // Custom icon for farmers
        var farmerIcon = L.icon({
            iconUrl: 'https://cdn-icons-png.flaticon.com/512/1000/1000143.png',
            iconSize: [38, 38], // size of the icon
            iconAnchor: [19, 38], // point of the icon which will correspond to marker's location
            popupAnchor: [0, -38] // point from which the popup should open relative to the iconAnchor
        });

        // Backenddən gələn fermerlərin siyahısı
        var farmers = [];
        @foreach (var f in Model)
        {
            // Simulyasiya üçün random koordinatlar generasiya edək
            // Real layihədə FermerProfile modelində Latitude və Longitude saxlanılmalıdır.
            <text>
                farmers.push({
                    name: '@f.ApplicationUser?.FirstName @f.ApplicationUser?.LastName',
                    district: '@f.District',
                    farmType: '@f.FarmType',
                    // Randomize slightly around Azerbaijan bounds for demonstration
                    lat: 39.0 + Math.random() * 2.5,
                    lng: 45.0 + Math.random() * 4.5
                });
            </text>
        }

        farmers.forEach(function(f) {
            var popupContent = "<b>" + f.name + "</b><br>" +
                               f.district + "<br>" +
                               "<i>" + f.farmType + "</i><br>" +
                               "<a href='/Marketplace' class='btn btn-sm btn-success mt-2'>Məhsullarına Bax</a>";

            L.marker([f.lat, f.lng], {icon: farmerIcon})
             .addTo(map)
             .bindPopup(popupContent);
        });
    </script>
}
