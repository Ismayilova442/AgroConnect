@model AgroConnect.Domain.Entities.ForumTopic
@using Microsoft.AspNetCore.Identity
@inject UserManager<AgroConnect.Domain.Entities.ApplicationUser> UserManager
@{
    ViewData["Title"] = Model.Title;
    var currentUser = await UserManager.GetUserAsync(User);
    bool isOwnerOrAdmin = currentUser != null && (Model.ApplicationUserId == currentUser.Id || User.IsInRole("SuperAdmin"));
}

<div class="mb-4">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i> Foruma qayıt</a>
</div>

<!-- Question -->
<div class="card shadow-sm mb-5 border-primary">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <h3 class="text-primary mb-0 fw-bold">@Model.Title</h3>
    </div>
    <div class="card-body fs-5" style="white-space: pre-wrap;">@Model.Content</div>
    <div class="card-footer bg-light text-muted d-flex justify-content-between align-items-center">
        <span><i class="bi bi-person-circle"></i> @Model.ApplicationUser?.FirstName @Model.ApplicationUser?.LastName</span>
        <span><i class="bi bi-clock"></i> @Model.CreatedAt.ToString("dd MMM yyyy HH:mm") &nbsp;&bull;&nbsp; <i class="bi bi-eye"></i> @Model.ViewsCount baxış</span>
    </div>
</div>

<h4 class="mb-4">@Model.Replies.Count Cavab</h4>

<!-- Replies -->
@foreach (var reply in Model.Replies.OrderByDescending(r => r.IsBestAnswer).ThenBy(r => r.CreatedAt))
{
    <div class="card shadow-sm mb-3 @(reply.IsBestAnswer ? "border-success" : "")">
        @if (reply.IsBestAnswer)
        {
            <div class="card-header bg-success text-white py-1 px-3 fw-bold small">
                <i class="bi bi-check-circle-fill"></i> Ən yaxşı cavab olaraq seçildi
            </div>
        }
        <div class="card-body">
            <p style="white-space: pre-wrap;">@reply.Content</p>
        </div>
        <div class="card-footer bg-white text-muted d-flex justify-content-between align-items-center border-top-0">
            <small><i class="bi bi-person"></i> @reply.ApplicationUser?.FirstName @reply.ApplicationUser?.LastName &nbsp;&bull;&nbsp; @reply.CreatedAt.ToString("dd MMM HH:mm")</small>
            
            @if (isOwnerOrAdmin && !reply.IsBestAnswer)
            {
                <form asp-action="MarkBestAnswer" method="post">
                    <input type="hidden" name="replyId" value="@reply.Id" />
                    <button type="submit" class="btn btn-outline-success btn-sm" title="Ən yaxşı cavab seç"><i class="bi bi-check-lg"></i></button>
                </form>
            }
        </div>
    </div>
}

<!-- Add Reply Form -->
@if (User.Identity!.IsAuthenticated)
{
    <div class="card shadow-sm mt-5">
        <div class="card-header bg-light fw-bold">Cavab Yaz</div>
        <div class="card-body p-4">
            <form asp-action="Reply" method="post">
                <input type="hidden" name="TopicId" value="@Model.Id" />
                <div class="mb-3">
                    <textarea name="Content" class="form-control" rows="4" required placeholder="Cavabınızı bura yazın..."></textarea>
                </div>
                <button type="submit" class="btn btn-primary"><i class="bi bi-reply"></i> Göndər</button>
            </form>
        </div>
    </div>
}
else
{
    <div class="alert alert-secondary mt-5 text-center">
        Cavab yazmaq üçün <a asp-area="Identity" asp-controller="Account" asp-action="Login">daxil olun</a>.
    </div>
}
