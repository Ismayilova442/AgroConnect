@model IEnumerable<AgroConnect.Domain.Entities.Complaint>
@using Microsoft.AspNetCore.Identity
@inject UserManager<AgroConnect.Domain.Entities.ApplicationUser> UserManager
@{
    ViewData["Title"] = "Şikayətlər";
    var currentUserId = User.Identity != null && User.Identity.IsAuthenticated ? UserManager.GetUserId(User) : null;
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle me-1"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle me-1"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2 mb-4">
    <div>
        <h2 class="mb-1"><i class="bi bi-megaphone text-danger"></i> Şikayətlər</h2>
        <p class="text-muted mb-0 small">Bütün istifadəçilər tərəfindən bildirilən şikayətlər burada göstərilir.</p>
    </div>

    @if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        <a asp-action="Create" class="btn btn-danger align-self-start align-self-sm-auto">
            <i class="bi bi-plus-circle me-1"></i> Şikayət Yaz
        </a>
    }
    else
    {
        <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-outline-danger align-self-start align-self-sm-auto">
            <i class="bi bi-box-arrow-in-right me-1"></i> Yazmaq üçün daxil olun
        </a>
    }
</div>

<!-- AXTARIŞ -->
<div class="card shadow-sm border-0 p-3 mb-4">
    <form method="get" asp-action="Index" class="row g-2 align-items-center">
        <div class="col-12 col-sm-9">
            <input type="text" name="search" value="@ViewBag.CurrentSearch" class="form-control" placeholder="İstifadəçi adına görə axtar..." />
        </div>
        <div class="col-12 col-sm-3 d-flex gap-2">
            <button type="submit" class="btn btn-danger flex-fill">
                <i class="bi bi-search"></i> Axtar
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-x-circle"></i>
            </a>
        </div>
    </form>
</div>

@if (!Model.Any())
{
    @if (!string.IsNullOrWhiteSpace(ViewBag.CurrentSearch as string))
    {
        <div class="alert alert-info">"@ViewBag.CurrentSearch" adına uyğun şikayət tapılmadı.</div>
    }
    else
    {
        <div class="alert alert-info">Hələ heç bir şikayət yoxdur.</div>
    }
}
else
{
    <div class="row row-cols-1 row-cols-md-2 g-4">
        @foreach (var item in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h5 class="card-title mb-0">@item.Subject</h5>
                            <span class="badge bg-secondary text-nowrap ms-2">@item.CreatedAt.ToString("dd.MM.yyyy")</span>
                        </div>
                        <p class="card-text" style="white-space: pre-line;">@item.Content</p>
                    </div>
                    <div class="card-footer bg-white border-top-0 d-flex justify-content-between align-items-center">
                        <small class="text-muted">
                            <i class="bi bi-person-circle me-1"></i>
                            @(item.ApplicationUser?.UserName ?? "Naməlum istifadəçi")
                        </small>

                        @if (currentUserId != null && item.ApplicationUserId == currentUserId)
                        {
                            <div class="d-flex gap-2">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-pencil"></i> Redaktə
                                </a>
                                <form asp-action="Delete" asp-route-id="@item.Id" method="post"
                                      onsubmit="return confirm('Bu şikayəti silmək istədiyinizə əminsiniz?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash"></i> Sil
                                    </button>
                                </form>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}
