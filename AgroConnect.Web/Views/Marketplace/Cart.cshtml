@model IEnumerable<AgroConnect.Web.ViewModels.CartItem>
@{
    ViewData["Title"] = "Səbətim";
}
<h2 class="mb-4"><i class="bi bi-cart3"></i> Səbətim</h2>
@if (!Model.Any())
{
    <div class="alert alert-warning">Səbətiniz boşdur. <a asp-action="Index">Alış-verişə başlayın!</a></div>
}
else
{
    <div class="table-responsive bg-white shadow-sm rounded p-3 mb-4">
        <table class="table align-middle">
            <thead class="table-light">
                <tr>
                    <th>Şəkil</th>
                    <th>Məhsul Adı</th>
                    <th>Qiymət</th>
                    <th>Miqdar</th>
                    <th>Cəmi</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @if (!string.IsNullOrEmpty(item.ImageUrl))
                            {
                                <img src="@item.ImageUrl" style="width: 50px; height: 50px; object-fit: cover;" class="rounded" />
                            }
                        </td>
                        <td class="fw-bold">@item.Title</td>
                        <td>@item.Price AZN</td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <form asp-action="UpdateQuantity" method="post" class="d-inline">
                                    <input type="hidden" name="productId" value="@item.ProductId" />
                                    <input type="hidden" name="change" value="-1" />
                                    <button type="submit" class="btn btn-sm btn-outline-secondary" disabled="@(item.Quantity <= 1)">
                                        <i class="bi bi-dash"></i>
                                    </button>
                                </form>
                                <span class="fw-bold" style="min-width: 24px; text-align:center; display:inline-block;">@item.Quantity</span>
                                <form asp-action="UpdateQuantity" method="post" class="d-inline">
                                    <input type="hidden" name="productId" value="@item.ProductId" />
                                    <input type="hidden" name="change" value="1" />
                                    <button type="submit" class="btn btn-sm btn-outline-secondary">
                                        <i class="bi bi-plus"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                        <td class="fw-bold text-success">@((item.Price * item.Quantity).ToString("0.00")) AZN</td>
                        <td>
                            <form asp-action="RemoveFromCart" method="post">
                                <input type="hidden" name="productId" value="@item.ProductId" />
                                <button type="submit" class="btn btn-sm btn-danger"><i class="bi bi-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="4" class="text-end fw-bold">Yekun Məbləğ:</td>
                    <td colspan="2" class="fw-bold text-success fs-5">@(Model.Sum(x => x.Price * x.Quantity).ToString("0.00")) AZN</td>
                </tr>
            </tfoot>
        </table>
    </div>
    <div class="d-flex justify-content-end gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary">Alış-verişə davam et</a>
        <a asp-action="Checkout" class="btn btn-success btn-lg">Sifarişi Rəsmiləşdir</a>
    </div>
}
