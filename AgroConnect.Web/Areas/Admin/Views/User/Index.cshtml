@model AgroConnect.Infrastructure.Common.PaginatedList<AgroConnect.Web.Areas.Admin.Controllers.UserListItemViewModel>
@{
    ViewData["Title"] = "İstifadəçilər";
    var roles = ViewBag.Roles as List<string>;
}

<h2 class="mb-4">İstifadəçilər</h2>

<!-- AXTARIŞ / FİLTR -->
<div class="card shadow-sm p-3 mb-3">
    <form method="get" asp-area="Admin" asp-controller="User" asp-action="Index" class="row g-2 align-items-center">
        <div class="col-md-5">
            <input type="text" name="search" value="@ViewBag.CurrentSearch" class="form-control" placeholder="Ad və ya email ilə axtar..." />
        </div>
        <div class="col-md-4">
            <select name="role" class="form-select">
                <option value="">-- Bütün rollar --</option>
                @if (roles != null)
                {
                    @foreach (var r in roles)
                    {
                        <option value="@r" selected="@(r == ViewBag.CurrentRole)">@r</option>
                    }
                }
            </select>
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-primary flex-fill">
                <i class="bi bi-search"></i> Axtar
            </button>
            <a asp-area="Admin" asp-controller="User" asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-x-circle"></i>
            </a>
        </div>
    </form>
</div>

<div class="card shadow-sm p-3">
    <div class="table-responsive">
        <table class="table table-bordered table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Ad</th>
                    <th>Email</th>
                    <th>Rol(lar)</th>
                    <th>Status</th>
                    <th>Əməliyyat</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    @foreach (var u in Model)
                    {
                        <tr>
                            <td>@u.UserName</td>
                            <td>@u.Email</td>
                            <td>
                                @if (u.Roles.Any())
                                {
                                    @foreach (var r in u.Roles)
                                    {
                                        <span class="badge bg-primary me-1">@r</span>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted">Rol yoxdur</span>
                                }
                            </td>
                            <td>
                                @if (u.IsLocked)
                                {
                                    <span class="badge bg-danger">Bloklanıb</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">Aktiv</span>
                                }
                            </td>
                            <td>
                                <form asp-area="Admin" asp-controller="User" asp-action="ToggleLock" asp-route-id="@u.Id" method="post" class="d-inline"
                                      data-confirm="Bu istifadəçinin statusunu dəyişmək istədiyinizə əminsiniz?" data-confirm-title="Statusu dəyiş">
                                    @if (u.IsLocked)
                                    {
                                        <button type="submit" class="btn btn-sm btn-outline-success">
                                            <i class="bi bi-unlock"></i> Blokdan çıxar
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            <i class="bi bi-lock"></i> Blokla
                                        </button>
                                    }
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted py-3">İstifadəçi yoxdur.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- PAGINATION -->
@if (Model.TotalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination justify-content-center">
            <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                <a class="page-link" asp-area="Admin" asp-controller="User" asp-action="Index"
                   asp-route-page="@(Model.PageIndex - 1)" asp-route-search="@ViewBag.CurrentSearch" asp-route-role="@ViewBag.CurrentRole">Əvvəlki</a>
            </li>
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                    <a class="page-link" asp-area="Admin" asp-controller="User" asp-action="Index"
                       asp-route-page="@i" asp-route-search="@ViewBag.CurrentSearch" asp-route-role="@ViewBag.CurrentRole">@i</a>
                </li>
            }
            <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                <a class="page-link" asp-area="Admin" asp-controller="User" asp-action="Index"
                   asp-route-page="@(Model.PageIndex + 1)" asp-route-search="@ViewBag.CurrentSearch" asp-route-role="@ViewBag.CurrentRole">Növbəti</a>
            </li>
        </ul>
        <p class="text-center text-muted small">Cəmi @Model.TotalCount istifadəçi</p>
    </nav>
}
