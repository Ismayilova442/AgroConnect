<!DOCTYPE html>
<html lang="az">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin Panel</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/admin.css" />
</head>
<body>

    <div class="d-flex">

        <!-- Sidebar -->
        <div class="admin-sidebar text-white p-3 vh-100"
             style="width:250px;position:fixed;overflow-y:auto;">

            <h4 class="text-center">Admin Panel</h4>

            <hr />

            <ul class="nav flex-column sidebar-nav">

                <li class="nav-item mb-2">
                    <a asp-area="Admin"
                       asp-controller="Dashboard"
                       asp-action="Index"
                       class="nav-link">
                        <i class="bi bi-speedometer2 me-2"></i>
                        Dashboard
                    </a>
                </li>

                @if (User.IsInRole("SuperAdmin"))
                {
                    <li class="nav-item mb-2">
                        <a asp-area="Admin"
                           asp-controller="Dashboard"
                           asp-action="FarmerRequests"
                           class="nav-link">
                            <i class="bi bi-file-earmark-check me-2"></i>
                            Fermer müraciətləri
                        </a>
                    </li>
                }

                @if (User.IsInRole("SuperAdmin"))
                {
                    <li class="nav-item mb-2">
                        <a asp-area="Admin"
                           asp-controller="Farmer"
                           asp-action="Index"
                           class="nav-link">
                            <i class="bi bi-person-badge me-2"></i>
                            Fermerlər
                        </a>
                    </li>
                }

                <li class="nav-item mb-2">
                    <a asp-area="Admin"
                       asp-controller="Category"
                       asp-action="Index"
                       class="nav-link">
                        <i class="bi bi-tags me-2"></i>
                        Kateqoriyalar
                    </a>
                </li>

                <li class="nav-item mb-2">
                    <a asp-area="Admin"
                       asp-controller="Product"
                       asp-action="Create"
                       class="nav-link">
                        <i class="bi bi-plus-circle me-2"></i>
                        Yeni Məhsul
                    </a>
                </li>

                <li class="nav-item mb-2">
                    <a asp-area="Admin"
                       asp-controller="Product"
                       asp-action="Index"
                       class="nav-link">
                        <i class="bi bi-box-seam me-2"></i>
                        Məhsullar
                    </a>
                </li>

                <li class="nav-item mb-2">
                    <a asp-area="Admin"
                       asp-controller="Order"
                       asp-action="Index"
                       class="nav-link">
                        <i class="bi bi-cart3 me-2"></i>
                        Sifarişlər
                    </a>
                </li>

                @if (User.IsInRole("SuperAdmin"))
                {
                    <li class="nav-item mb-2">
                        <a asp-area="Admin"
                           asp-controller="User"
                           asp-action="Index"
                           class="nav-link">
                            <i class="bi bi-people me-2"></i>
                            İstifadəçilər
                        </a>
                    </li>

                    <li class="nav-item mb-2">
                        <a asp-area="Admin"
                           asp-controller="Admin"
                           asp-action="Index"
                           class="nav-link">
                            <i class="bi bi-shield-lock me-2"></i>
                            Adminlər
                        </a>
                    </li>
                }

                <hr />

                <li class="nav-item">
                    <a asp-area=""
                       asp-controller="Home"
                       asp-action="Index"
                       class="nav-link text-warning">
                        <i class="bi bi-house-door me-2"></i>
                        Sayta qayıt
                    </a>
                </li>

            </ul>

        </div>

        <!-- Content -->
        <div class="admin-content flex-grow-1 p-4 bg-light"
             style="margin-left:250px;min-height:100vh;">

            @RenderBody()

        </div>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/admin.js"></script>

    @if (TempData["Success"] != null)
    {
        <script>
            showAppToast('success', @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["Success"])));
        </script>
    }
    @if (TempData["Error"] != null)
    {
        <script>
            showAppToast('error', @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["Error"])));
        </script>
    }

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
