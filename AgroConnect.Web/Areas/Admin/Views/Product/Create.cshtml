@model AgroConnect.Domain.Entities.Product
@{
    ViewData["Title"] = "Yeni Mal Əlavə Et";
}

<div class="card shadow-sm p-4" style="max-width: 600px; margin: auto;">
    <h2>Yeni Məhsul (Mal) Əlavə Et</h2>
    <hr />
    <form asp-area="Admin" asp-controller="Product" asp-action="Create" method="post" enctype="multipart/form-data">
        <div class="mb-3">
            <label class="form-label">Kateqoriya Seçin</label>
            <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.Categories" required>
                <option value="">-- Kateqoriya Seçin --</option>
            </select>
            <span asp-validation-for="CategoryId" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label class="form-label">Məhsulun Adı (Başlıq)</label>
            <input asp-for="Title" class="form-control" required />
            <span asp-validation-for="Title" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label class="form-label">Qiyməti (AZN)</label>
            <input asp-for="Price" type="number" step="0.01" class="form-control" required />
            <span asp-validation-for="Price" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label class="form-label">Stok Miqdarı (Ədəd / Kq)</label>
            <input asp-for="StockQuantity" type="number" class="form-control" required />
            <span asp-validation-for="StockQuantity" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label class="form-label">Təsviri / Açıqlama</label>
            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label class="form-label">Məhsulun Şəkli</label>
            <input type="file" name="imageFile" class="form-control" required />
        </div>
        <button type="submit" class="btn btn-success w-100">Məhsulu Əlavə Et</button>
    </form>
</div>
