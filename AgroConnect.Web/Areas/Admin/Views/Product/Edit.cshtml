@model AgroConnect.Domain.Entities.Product
@{
    ViewData["Title"] = "Məhsulu Redaktə Et";
}

<div class="card shadow-sm p-4" style="max-width: 600px; margin: auto;">
    <h2>Məhsulu Redaktə Et</h2>
    <hr />

    @if (!string.IsNullOrEmpty(Model.ImageUrl))
    {
        <img src="@Model.ImageUrl" style="width:100px;height:100px;object-fit:cover;border-radius:8px;" class="mb-3" />
    }

    <form asp-area="Admin" asp-controller="Product" asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
        <input type="hidden" asp-for="Id" />
        <div class="mb-3">
            <label class="form-label">Kateqoriya Seçin</label>
            <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.Categories" required>
                <option value="">-- Kateqoriya Seçin --</option>
            </select>
            <span asp-validation-for="CategoryId" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label class="form-label">Məhsulun Adı (Başlıq)</label>
            <input asp-for="Title" class="form-control" required />
            <span asp-validation-for="Title" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label class="form-label">Qiyməti (AZN)</label>
            <input asp-for="Price" type="number" step="0.01" class="form-control" required />
            <span asp-validation-for="Price" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label class="form-label">Stok Miqdarı (Ədəd / Kq)</label>
            <input asp-for="StockQuantity" type="number" class="form-control" required />
            <span asp-validation-for="StockQuantity" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label class="form-label">Təsviri / Açıqlama</label>
            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label class="form-label">Yeni Şəkil (boş buraxsanız, köhnə şəkil qalır)</label>
            <input type="file" name="imageFile" class="form-control" />
        </div>
        <button type="submit" class="btn btn-primary w-100">Yadda saxla</button>
        <a asp-area="Admin" asp-controller="Product" asp-action="Index" class="btn btn-secondary w-100 mt-2">Geri qayıt</a>
    </form>
</div>
