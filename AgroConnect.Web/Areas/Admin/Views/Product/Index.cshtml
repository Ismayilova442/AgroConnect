@model AgroConnect.Infrastructure.Common.PaginatedList<AgroConnect.Domain.Entities.Product>
@{
    ViewData["Title"] = "Məhsullar";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Məhsullar</h2>
    <div class="d-flex gap-2">
        <a asp-area="Admin" asp-controller="Product" asp-action="ExportExcel"
           asp-route-search="@ViewBag.CurrentSearch" asp-route-categoryId="@ViewBag.CurrentCategory"
           class="btn btn-outline-success">
            <i class="bi bi-file-earmark-excel"></i> Excel
        </a>
        <a asp-area="Admin" asp-controller="Product" asp-action="ExportPdf"
           asp-route-search="@ViewBag.CurrentSearch" asp-route-categoryId="@ViewBag.CurrentCategory"
           class="btn btn-outline-danger">
            <i class="bi bi-file-earmark-pdf"></i> PDF
        </a>
        <a asp-area="Admin" asp-controller="Product" asp-action="Create" class="btn btn-success">
            <i class="bi bi-plus-circle me-1"></i> Yeni Məhsul
        </a>
    </div>
</div>

<!-- AXTARIŞ / FİLTR -->
<div class="card shadow-sm p-3 mb-3">
    <form method="get" asp-area="Admin" asp-controller="Product" asp-action="Index" class="row g-2 align-items-center">
        <div class="col-md-5">
            <input type="text" name="search" value="@ViewBag.CurrentSearch" class="form-control" placeholder="Məhsul adına görə axtar..." />
        </div>
        <div class="col-md-4">
            <select name="categoryId" class="form-select" asp-items="ViewBag.Categories">
                <option value="">-- Bütün kateqoriyalar --</option>
            </select>
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-primary flex-fill">
                <i class="bi bi-search"></i> Axtar
            </button>
            <a asp-area="Admin" asp-controller="Product" asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-x-circle"></i>
            </a>
        </div>
    </form>
</div>

<div class="card shadow-sm p-3">
    <div class="table-responsive">
        <table class="table table-bordered table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Şəkil</th>
                    <th>Ad</th>
                    <th>Kateqoriya</th>
                    <th>Qiymət</th>
                    <th>Stok</th>
                    <th>Fermer</th>
                    <th>Əməliyyatlar</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    @foreach (var p in Model)
                    {
                        <tr>
                            <td>
                                @if (!string.IsNullOrEmpty(p.ImageUrl))
                                {
                                    <img src="@p.ImageUrl" style="width:50px;height:50px;object-fit:cover;border-radius:6px;" />
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td>@p.Title</td>
                            <td>@(p.Category?.Name ?? "—")</td>
                            <td>@p.Price AZN</td>
                            <td>
                                @if (p.StockQuantity <= 0)
                                {
                                    <span class="badge bg-danger">Bitib</span>
                                }
                                else
                                {
                                    @p.StockQuantity
                                }
                            </td>
                            <td>@(p.FarmerProfile?.ApplicationUser?.Email ?? "—")</td>
                            <td>
                                <a asp-area="Admin" asp-controller="Product" asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form asp-area="Admin" asp-controller="Product" asp-action="Delete" asp-route-id="@p.Id" method="post" class="d-inline"
                                      data-confirm="Bu məhsulu silmək istədiyinizə əminsiniz?" data-confirm-title="Məhsulu sil">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-3">Məhsul yoxdur.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- PAGINATION -->
@if (Model.TotalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination justify-content-center">
            <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                <a class="page-link" asp-area="Admin" asp-controller="Product" asp-action="Index"
                   asp-route-page="@(Model.PageIndex - 1)" asp-route-search="@ViewBag.CurrentSearch" asp-route-categoryId="@ViewBag.CurrentCategory">Əvvəlki</a>
            </li>
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                    <a class="page-link" asp-area="Admin" asp-controller="Product" asp-action="Index"
                       asp-route-page="@i" asp-route-search="@ViewBag.CurrentSearch" asp-route-categoryId="@ViewBag.CurrentCategory">@i</a>
                </li>
            }
            <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                <a class="page-link" asp-area="Admin" asp-controller="Product" asp-action="Index"
                   asp-route-page="@(Model.PageIndex + 1)" asp-route-search="@ViewBag.CurrentSearch" asp-route-categoryId="@ViewBag.CurrentCategory">Növbəti</a>
            </li>
        </ul>
        <p class="text-center text-muted small">Cəmi @Model.TotalCount məhsul</p>
    </nav>
}
