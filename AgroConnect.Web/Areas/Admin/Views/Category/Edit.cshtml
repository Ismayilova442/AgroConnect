@model AgroConnect.Domain.Entities.Category
@{
    ViewData["Title"] = "Kateqoriyanı Redaktə Et";
}

<div class="card shadow-sm p-4" style="max-width: 500px; margin: auto;">
    <h2>Kateqoriyanı Redaktə Et</h2>
    <hr />
    <form asp-area="Admin" asp-controller="Category" asp-action="Edit" asp-route-id="@Model.Id" method="post">
        <input type="hidden" asp-for="Id" />
        <div class="mb-3">
            <label class="form-label">Kateqoriya Adı</label>
            <input asp-for="Name" class="form-control" required />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label class="form-label">İkon Klası (Bootstrap Icons)</label>
            <input asp-for="IconClass" class="form-control" placeholder="Örnək: bi-apple" />
        </div>
        <button type="submit" class="btn btn-primary w-100">Yadda saxla</button>
        <a asp-area="Admin" asp-controller="Category" asp-action="Index" class="btn btn-secondary w-100 mt-2">Geri qayıt</a>
    </form>
</div>
