@model AgroConnect.Infrastructure.Common.PaginatedList<AgroConnect.Web.Areas.Admin.Controllers.FarmerListItemViewModel>
@{
    ViewData["Title"] = "Fermerlər";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Təsdiqlənmiş Fermerlər</h2>
    <div class="d-flex gap-2">
        <a asp-area="Admin" asp-controller="Farmer" asp-action="ExportExcel" asp-route-search="@ViewBag.CurrentSearch" class="btn btn-outline-success">
            <i class="bi bi-file-earmark-excel"></i> Excel
        </a>
        <a asp-area="Admin" asp-controller="Farmer" asp-action="ExportPdf" asp-route-search="@ViewBag.CurrentSearch" class="btn btn-outline-danger">
            <i class="bi bi-file-earmark-pdf"></i> PDF
        </a>
    </div>
</div>

<!-- AXTARIŞ -->
<div class="card shadow-sm p-3 mb-3">
    <form method="get" asp-area="Admin" asp-controller="Farmer" asp-action="Index" class="row g-2 align-items-center">
        <div class="col-md-9">
            <input type="text" name="search" value="@ViewBag.CurrentSearch" class="form-control" placeholder="Ad, email, rayon və ya kənd üzrə axtar..." />
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-primary flex-fill">
                <i class="bi bi-search"></i> Axtar
            </button>
            <a asp-area="Admin" asp-controller="Farmer" asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-x-circle"></i>
            </a>
        </div>
    </form>
</div>

<div class="card shadow-sm p-3">
    <div class="table-responsive">
        <table class="table table-bordered table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Fermer</th>
                    <th>Email</th>
                    <th>Rayon / Kənd</th>
                    <th>Fəaliyyət növü</th>
                    <th>Məhsul sayı</th>
                    <th>Əməliyyat</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    @foreach (var f in Model)
                    {
                        <tr>
                            <td>@f.UserName</td>
                            <td>@f.Email</td>
                            <td>@f.District / @f.Village</td>
                            <td><span class="badge bg-primary">@f.FarmType</span></td>
                            <td>@f.ProductCount</td>
                            <td>
                                <a asp-area="Admin" asp-controller="Farmer" asp-action="Details" asp-route-id="@f.Id" class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-eye"></i> Bax
                                </a>
                                <form asp-area="Admin" asp-controller="Farmer" asp-action="Block" asp-route-id="@f.Id" method="post" class="d-inline"
                                      data-confirm="Bu fermerin fəaliyyətini dayandırmaq istədiyinizə əminsiniz?" data-confirm-title="Fəaliyyəti dayandır">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-slash-circle"></i> Dayandır
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-3">Nəticə tapılmadı.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- PAGINATION -->
@if (Model.TotalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination justify-content-center">
            <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                <a class="page-link" asp-area="Admin" asp-controller="Farmer" asp-action="Index"
                   asp-route-page="@(Model.PageIndex - 1)" asp-route-search="@ViewBag.CurrentSearch">Əvvəlki</a>
            </li>
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                    <a class="page-link" asp-area="Admin" asp-controller="Farmer" asp-action="Index"
                       asp-route-page="@i" asp-route-search="@ViewBag.CurrentSearch">@i</a>
                </li>
            }
            <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                <a class="page-link" asp-area="Admin" asp-controller="Farmer" asp-action="Index"
                   asp-route-page="@(Model.PageIndex + 1)" asp-route-search="@ViewBag.CurrentSearch">Növbəti</a>
            </li>
        </ul>
        <p class="text-center text-muted small">Cəmi @Model.TotalCount fermer</p>
    </nav>
}
