@model List<AgroConnect.Web.Areas.Admin.Controllers.AdminListItemViewModel>
@{
    ViewData["Title"] = "Adminlər";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Adminlər</h2>
    <a asp-area="Admin" asp-controller="Admin" asp-action="Create" class="btn btn-success">
        <i class="bi bi-plus-circle me-1"></i> Yeni Admin
    </a>
</div>

<div class="card shadow-sm p-3">
    <div class="table-responsive">
        <table class="table table-bordered table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Ad</th>
                    <th>Email</th>
                    <th>Rol</th>
                    <th>Əməliyyat</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    @foreach (var a in Model)
                    {
                        <tr>
                            <td>@a.UserName</td>
                            <td>@a.Email</td>
                            <td>
                                @if (a.IsSuperAdmin)
                                {
                                    <span class="badge bg-dark">SuperAdmin</span>
                                }
                                else
                                {
                                    <span class="badge bg-primary">Admin</span>
                                }
                            </td>
                            <td>
                                @if (!a.IsSuperAdmin)
                                {
                                    <form asp-area="Admin" asp-controller="Admin" asp-action="RemoveAdmin" asp-route-id="@a.Id" method="post" class="d-inline"
                                          data-confirm="Bu istifadəçini admin siyahısından çıxarmaq istədiyinizə əminsiniz?" data-confirm-title="Admini sil">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            <i class="bi bi-trash"></i> Sil
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <span class="text-muted small">Qorunur</span>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" class="text-center text-muted py-3">Admin yoxdur.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
